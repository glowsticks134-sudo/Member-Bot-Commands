# ─── Bot 1 — Main Bot ─────────────────────────────────────────────────────────
# Handles all admin slash commands, the web server, and OAuth callbacks.
# Found in the Discord Developer Portal (https://discord.com/developers/applications)

# Bot Token — Bot tab → Token
DISCORD_TOKEN_1=your_bot1_token_here

# Application (Client) ID — General Information → Application ID
DISCORD_CLIENT_ID=your_client_id_here

# Client Secret — General Information → Client Secret
DISCORD_CLIENT_SECRET=your_client_secret_here

# ─── Bot 2 — Verification Bot (optional) ─────────────────────────────────────
# Posts the public "Verify Now" embed in your server using /send_verify.
# If not set, Bot 1 posts the embed instead.

DISCORD_TOKEN_2=your_bot2_token_here

# ─── Bot 3 — Joiner Bot (optional) ───────────────────────────────────────────
# Gets added to target servers and is used to mass-join members via /djoin.
# If not set, Bot 1's token is used for guild adds instead.

DISCORD_TOKEN_3=your_bot3_token_here

# ─── OAuth2 Redirect URI ──────────────────────────────────────────────────────
# The full public URL where Discord sends users after they authorize.
# Must exactly match a Redirect URI in your Discord Developer Portal → OAuth2 → Redirects.
#
# On Replit this is auto-detected — leave blank unless you need to pin it.
REDIRECT_URI=https://your-repl.replit.app/auth/callback

# ─── Server Port ─────────────────────────────────────────────────────────────
# The port the web server listens on. Defaults to 5000 on Replit.
PORT=5000
