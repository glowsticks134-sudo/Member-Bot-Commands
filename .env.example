# ─── Bot 1 — Main Bot ─────────────────────────────────────────────────────────
TOKEN_1=your_bot1_token_here
CLIENT_1=your_client_id_here
SECRET_1=your_client_secret_here

# ─── Bot 2 — Verification Bot (optional) ─────────────────────────────────────
# Posts the public "Verify Now" embed via /send_verify
TOKEN_2=your_bot2_token_here

# ─── Bot 3 — Joiner Bot (optional) ───────────────────────────────────────────
# Used for mass-joining members via /djoin
TOKEN_3=your_bot3_token_here

# ─── Bot 4 — Token Distributor (optional) ────────────────────────────────────
# Manages a public token pool where users can claim tokens via commands
TOKEN_4=your_bot4_token_here

# ─── OAuth2 Redirect URI (optional) ──────────────────────────────────────────
# Auto-detected on Replit — only set this if you need to pin it
REDIRECT_URI=https://your-repl.replit.app/auth/callback

# ─── Port (optional) ──────────────────────────────────────────────────────────
PORT=5000
